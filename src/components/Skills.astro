---
import Pill from './Pill.astro';
import Tags from './Tags.astro';
import type { iconPaths } from './IconPaths';

type Skill = {
	name: string;
	icon?: keyof typeof iconPaths;
	tags: string[];
	about: string;
};

interface Props {
	skills?: Skill[] | undefined;
}

const {
	skills = [
		{
			name: "ABAP",
			icon: "sap-community-logo",
			tags: ["Backend", "SAP"],
			about: "ABAP is a programming language used for developing applications in the SAP environment."
		},	
		{
			name: "SAPUI5",
			icon: "layout",
			tags: ["Frontend", "SAP"],
			about: "SAPUI5 is a JavaScript framework used for building responsive web applications in the SAP ecosystem."
		},
		{
			name: "Fiori",
			icon: "flower-tylip",
			tags: ["UX", "SAP"],
			about: "Fiori is a design language and user experience (UX) framework developed by SAP for creating intuitive and user-friendly applications."
		},
		{
			name: "JavaScript",
			icon: "curly-braces",
			tags: ["Frontend", "Backend"],
			about: "JavaScript is a versatile programming language primarily used for web development, enabling interactive and dynamic content on websites."
		},
		{
			name: "TypeScript",
			icon: "code",
			tags: ["Frontend", "Backend"],
			about: "TypeScript is a superset of JavaScript that adds static typing, enhancing code quality and maintainability in large-scale applications."
		},
		{
			name: "HANA",
			icon: "database",
			tags: ["Database", "SAP"],
			about: "HANA is an in-memory database platform developed by SAP, designed for real-time data processing and analytics."
		},
		{
			name: "BTP",
			icon: "cloud",
			tags: ["Cloud", "SAP"],
			about: "BTP (Business Technology Platform) is SAP's cloud platform that provides tools and services for building, integrating, and extending applications."
		},
		{
			name: "Node.js",
			icon: "hexagon",
			tags: ["Backend", "JavaScript"],
			about: "Node.js is a runtime environment that allows developers to run JavaScript on the server side, enabling scalable network applications."
		},
		{
			name: "Cloud Foundry",
			icon: "cloud",
			tags: ["Cloud", "Platform"],
			about: "Cloud Foundry is an open-source cloud application platform that enables developers to deploy and manage applications in various cloud environments."
		},		
	],
} = Astro.props;
---

<section class="box skills">
	{skills.map(({ name, icon = 'code', tags, about }) => (
		<div class="stack gap-2 lg:gap-4">
			<Pill icon={icon} label={name} />
			<p>{about}</p>
			<Tags tags={tags} />
		</div>
	))}
</section>

<style>
	.box {
		border: 1px solid var(--gray-800);
		border-radius: 0.75rem;
		padding: 1.5rem;
		background-color: var(--gray-999_40);
		box-shadow: var(--shadow-sm);
	}

	.skills {
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	.skills p {
		color: var(--gray-400);
	}

	@media (min-width: 50em) {
		.box {
			border-radius: 1.5rem;
			padding: 2.5rem;
		}

		.skills {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 5rem;
		}
	}
</style>
